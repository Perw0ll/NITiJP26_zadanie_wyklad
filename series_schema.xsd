<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:element name="series_catalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="series" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="title" type="xs:string"/>
              <xs:element name="release_year" type="xs:gYear"/>
              <xs:element name="seasons" type="xs:positiveInteger"/>
              <xs:element name="genres">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="genre" type="xs:string" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="platforms">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="platform" type="xs:string" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="rating">
                <xs:simpleType>
                  <xs:restriction base="xs:decimal">
                    <xs:minInclusive value="0.0"/>
                    <xs:maxInclusive value="10.0"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="completed" type="xs:boolean"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
